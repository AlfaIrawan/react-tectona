# Auth providers — comma-separated; order controls social button order on login/register.
# Values: password | microsoft | google | meta
# VITE_AUTH_PROVIDERS=password
# VITE_AUTH_PROVIDERS=password,google
# VITE_AUTH_PROVIDERS=password,microsoft,google,meta
#
# Ubuntu dev deploy (TeamCity): lihat .env.dev + `vite build --mode dev`
# VITE_APP_ENV=development | production — topbar badge (default: production saat vite build)

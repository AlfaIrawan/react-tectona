# Ubuntu dev deploy — dipakai `vite build --mode dev` (TeamCity DeployFrontendTectona).
# Bukan production: same-origin /api/* lewat nginx di tectona-dev.adira.co.id / :9411.
# Variabel di sini menimpa .env untuk build dev di server.

# Topbar environment badge (vite build --mode dev tetap PROD=true)
VITE_APP_ENV=development

# ── Auth (login / register) ───────────────────────────────────────────────────
VITE_AUTH_PROVIDERS=password,microsoft
VITE_TECTONA_OIDC_CLIENT_ID=tectona-spa

# ── Workspace gate ────────────────────────────────────────────────────────────
VITE_TECTONA_REQUIRE_WORKSPACE_MEMBERSHIP=true

# ── Corporate onboarding ───────────────────────────────────────────────────────
VITE_TECTONA_REQUIRE_EMAIL_VERIFICATION=false
VITE_TECTONA_CORPORATE_ADMIN_APPROVAL=true
VITE_TECTONA_CORPORATE_ONBOARDING_CHOICE=true
VITE_TECTONA_CORPORATE_EMAIL_OPTION=true

# ── API clients (same-origin — nginx proxy) ───────────────────────────────────
VITE_IDENTITY_LITE_API_URL=/api/identity-lite
VITE_GATEWAY_RUNTIME_URL=/api/gateway-runtime
VITE_PROJECT_API_URL=/api/project-service
VITE_IDEA_BACKLOG_API_URL=/api/idea-backlog
VITE_WORKFLOW_AUTOMATION_API_URL=/api/workflow-automation
VITE_TODO_API_URL=/api/todo
VITE_NOTIFICATION_API_URL=/api/notification-service
VITE_COLLABORATION_CONTEXT_API_URL=/api/collaboration-context
VITE_DOCUMENT_KNOWLEDGE_API_URL=/api/document-knowledge/v1
VITE_DOCUMENT_PARSER_API_URL=/api/document-parser
VITE_TECTONA_KB_API_URL=/api/tectona-kb/v1
VITE_TECTONA_VOICE_API_URL=/api/tectona-voice
VITE_TECTONA_AGENT_RUNTIME_API_URL=/api/tectona-agent-runtime
VITE_TILIA_AGENT_RUNTIME_API_URL=/api/tilia-agent-runtime
VITE_WORKSPACE_GOVERNANCE_API_URL=/api/workspace-governance
VITE_GOVERNANCE_CONFIG_API_URL=/api/governance-config
VITE_REGISTRY_CORE_API_URL=/api/registry-core

# Registry RUM ingest — same-origin via nginx /api/registry → :8405 (avoid cross-origin CORS)
VITE_REGISTRY_API_URL=same-origin
VITE_UI_MANIFEST_URL=/ui-manifest.json

# ── Self-registration (registry-core) ─────────────────────────────────────────
VITE_OTEL_SERVICE_NAME=frontend-tectona
VITE_SELF_SERVICE_ID=frontend-tectona
VITE_SELF_SERVICE_NAME=Tectona
VITE_SELF_SERVICE_TYPE=frontend

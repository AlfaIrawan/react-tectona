# AWS Dev (ap-southeast-1) — `npm run build:awsdev` → s3://tectona-dev-frontend-w16 behind
# CloudFront d3swtxxlumxfkm.cloudfront.net (Free plan, WAF IP allowlist, OAC).
# All backends share one CloudFront behavior `/api/*`; the CloudFront Function
# tectona-dev-api-router picks the Lambda origin from the 2nd path segment (/api/<service>/...)
# and returns a JSON 404 for services that are not on AWS yet. No secrets in this file.

VITE_APP_ENV=development

# ── Auth (login / register) ───────────────────────────────────────────────────
# identity-lite is not on AWS yet (router answers 404), so login cannot work from this origin.
VITE_AUTH_PROVIDERS=password,microsoft
VITE_TECTONA_OIDC_CLIENT_ID=tectona-spa
VITE_IDENTITY_LITE_API_URL=/api/identity-lite

VITE_TECTONA_REQUIRE_WORKSPACE_MEMBERSHIP=true
VITE_TECTONA_REQUIRE_EMAIL_VERIFICATION=false
VITE_TECTONA_CORPORATE_ADMIN_APPROVAL=true
VITE_TECTONA_CORPORATE_ONBOARDING_CHOICE=true
VITE_TECTONA_CORPORATE_EMAIL_OPTION=true

# ── Backends (same-origin /api/<service>, CloudFront router) ─────────────────
# Live on AWS: user-preferences (mounts at /api/user-preferences, no prefix strip).
# api-catalog is routed at /api/api-catalog (prefix stripped) but has no FE client yet.
VITE_USER_PREFERENCES_API_URL=/api/user-preferences
# Set explicitly so nothing falls back to /api/gateway-runtime; these return the router's
# JSON 404 until each service moves to AWS.
VITE_PROJECT_API_URL=/api/project-service
VITE_IDEA_BACKLOG_API_URL=/api/idea-backlog
VITE_TODO_API_URL=/api/todo
VITE_NOTIFICATION_API_URL=/api/notification-service
VITE_WORKSPACE_ACCESS_CONTROL_API_URL=/api/workspace-access-control
VITE_WORKSPACE_ORG_API_URL=/api/workspace-org
VITE_WORKSPACE_GOVERNANCE_API_URL=/api/workspace-governance
VITE_GOVERNANCE_CONFIG_API_URL=/api/governance-config
VITE_TECTONA_ACTIVITY_API_URL=/api/tectona-activity
# Every /api/* request goes through OAC: POST/PUT/PATCH get x-amz-content-sha256
# (src/lib/oacSigning.ts).
VITE_OAC_SIGNED_PATH_PREFIXES=/api

VITE_UI_MANIFEST_URL=/ui-manifest.json
VITE_OTEL_SERVICE_NAME=frontend-tectona
# Deliberately unset: VITE_REGISTRY_API_URL / VITE_REGISTRY_RUM_API_KEY (RUM ingest off) and
# VITE_SELF_SERVICE_ID (registry-core self-registration off) — no registry on AWS Dev.

# Auth providers — comma-separated; order controls social button order on login/register.
# Values: password | microsoft | google | meta
# VITE_AUTH_PROVIDERS=password
# VITE_AUTH_PROVIDERS=password,google
# VITE_AUTH_PROVIDERS=password,microsoft,google,meta
#
# Ubuntu dev deploy (TeamCity): lihat .env.dev + `vite build --mode dev`
# VITE_APP_ENV=development | production — topbar badge (default: production saat vite build)
#
# Chat assistant — same-origin nginx, bukan gateway-runtime:
# VITE_TECTONA_AGENT_RUNTIME_API_URL=/api/tectona-agent-runtime
#
# Knowledge Index embeddings / retrieve — same-origin nginx → :8417
# VITE_TECTONA_KNOWLEDGE_INDEX_API_URL=/api/tectona-knowledge-index
#
# Workspace UUIDs where Application Portfolio Monitoring is the SoR (turns off Application Catalog Default for AI).
# VITE_TECTONA_APM_WORKSPACE_IDS=
#
# Browser RUM ingest (optional). Must match REGISTRY_RUM_INGEST_API_KEY on the registry.
# Without this, Tectona will not POST /api/registry/services/*/rum-metrics.
# VITE_REGISTRY_RUM_API_KEY=

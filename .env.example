# Tectona frontend — environment (contoh)
# Salin ke .env untuk override lokal.

# Gate akses aplikasi: user harus punya ≥1 workspace membership (WAC) atau role platform admin.
# Default: aktif (production-like). Set false hanya jika perlu iterasi cepat tanpa membership.
# VITE_TECTONA_REQUIRE_WORKSPACE_MEMBERSHIP=false

# Opsional: langsung ke agent runtime (8414) lewat Vite proxy, bukan gateway-runtime (8084).
# VITE_TECTONA_AGENT_RUNTIME_API_URL=/api/tectona-agent-runtime

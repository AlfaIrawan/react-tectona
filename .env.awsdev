# AWS Dev (ap-southeast-1) — `npm run build:awsdev` → s3://tectona-dev-frontend-w16 behind
# CloudFront d3swtxxlumxfkm.cloudfront.net (Free plan, WAF office-IP allowlist, OAC).
# Only user-preferences and api-catalog have AWS backends so far; every other /api/* client
# keeps its default path and fails cleanly (S3 403) until its service moves to AWS.
# No secrets in this file.

VITE_APP_ENV=development

# ── Auth (login / register) ───────────────────────────────────────────────────
# identity-lite is still on-prem (issuer http://localhost:8430), so login cannot work from
# this origin yet. Point this at a browser-reachable identity-lite once one exists.
VITE_AUTH_PROVIDERS=password,microsoft
VITE_TECTONA_OIDC_CLIENT_ID=tectona-spa
VITE_IDENTITY_LITE_API_URL=/api/identity-lite

VITE_TECTONA_REQUIRE_WORKSPACE_MEMBERSHIP=true
VITE_TECTONA_REQUIRE_EMAIL_VERIFICATION=false
VITE_TECTONA_CORPORATE_ADMIN_APPROVAL=true
VITE_TECTONA_CORPORATE_ONBOARDING_CHOICE=true
VITE_TECTONA_CORPORATE_EMAIL_OPTION=true

# ── AWS Lambda backends (same-origin CloudFront paths) ────────────────────────
# CloudFront strips the /user-preferences prefix; the FastAPI app mounts at
# /api/user-preferences/v1, so the base keeps that path after the prefix.
VITE_USER_PREFERENCES_API_URL=/user-preferences/api/user-preferences
# OAC-signed prefixes: POST/PUT/PATCH get x-amz-content-sha256 (see httpClient.ts).
VITE_OAC_SIGNED_PATH_PREFIXES=/user-preferences,/api-catalog

VITE_UI_MANIFEST_URL=/ui-manifest.json
VITE_OTEL_SERVICE_NAME=frontend-tectona
# Deliberately unset: VITE_REGISTRY_API_URL / VITE_REGISTRY_RUM_API_KEY (RUM ingest off) and
# VITE_SELF_SERVICE_ID (registry-core self-registration off) — no registry on AWS Dev.
